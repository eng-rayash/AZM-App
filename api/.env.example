# انسخه إلى .env — و.env لا يدخل المستودع أبدًا.

# 127.0.0.1 لا localhost: على ويندوز يُحلّ الأخير إلى ::1 أحيانًا
# فيفشل الاتصال بـP1001 رغم أن الحاوية تعمل.
DATABASE_URL="postgresql://azm:azm_dev_only@127.0.0.1:5433/azm?schema=public"

# سرّ توقيع الرموز. ولّد واحدًا حقيقيًا للإنتاج:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

PORT=3000
NODE_ENV=development
